{
  // Cloudflare Worker that serves the built site (static files only).
  // Cloudflare runs `npx wrangler deploy` on every push to `main`;
  // the build step below runs first and produces ./dist.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fotojoepics-website",
  "compatibility_date": "2026-11-10",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
